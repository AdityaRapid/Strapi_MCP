# Example environment configuration for Strapi MCP Server
# Copy this file to .env and fill in your values

# Strapi Configuration (Required for deployment)
STRAPI_API_URL=http://localhost:1337
STRAPI_API_KEY=your-jwt-token-here

# Optional Strapi Configuration
STRAPI_SERVER_NAME=default
STRAPI_VERSION=5.*

# Optional MCP Server Configuration
MCP_LOG_LEVEL=INFO
MCP_ENABLE_DEBUG=false
MCP_SANITIZE_DATA=true
MCP_INCLUDE_STACK_TRACE=false

# Legacy configuration (still supported for file-based config)
API_URL=http://localhost:1337
JWT=your-jwt-token-here